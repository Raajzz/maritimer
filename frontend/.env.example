# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development only: show a "sign in as demo user" picker that sends `Bearer dev:<email>`.
# The backend must also run with AUTH_DEV_TOKENS=true. Never enable in production.
VITE_DEV_AUTH=true
