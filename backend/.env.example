# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev        # config.settings.prod in production
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://maritimer:maritimer@localhost:5432/maritimer

# ---- Auth (Firebase) ----
FIREBASE_PROJECT_ID=your-firebase-project-id
# base64 of the service-account JSON (optional: token verification only needs the project id)
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_CHECK_REVOKED=false
# Dev only: accept "Authorization: Bearer dev:<email>". Always false in prod settings.
AUTH_DEV_TOKENS=true

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=

# ---- Storage: local (dev) or s3 (Cloudflare R2 / AWS S3) ----
STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ENDPOINT_URL=                 # e.g. https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=auto
S3_URL_EXPIRE_SECONDS=300

# ---- Domain ----
FDA_DISPUTE_WINDOW_DAYS=0
SETTLEMENT_WRITEOFF_TOLERANCE=0.00
# Production only: DB role that must not UPDATE/DELETE audit_log (applied by migration core.0099)
AUDIT_LOG_REVOKE_ROLE=
